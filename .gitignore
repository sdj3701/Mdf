# This .gitignore file is customized for a project structure where the Unity project ('Mdfproject') is in a subfolder of the git root.

# Unity #
Mdfproject/[Ll]ibrary/
Mdfproject/[Tt]emp/
Mdfproject/[Oo]bj/
Mdfproject/[Bb]uild/
Mdfproject/[Bb]uilds/
Mdfproject/[Ll]ogs/
Mdfproject/[Uu]ser[Ss]ettings/
Mdfproject/*.log
.utmp/

# IDE & Editor Files #
# Visual Studio / Rider / VS Code
.vs/
.vscode/
/.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.DotSettings.user

# Mac #
.DS_Store

# Blender #
*.blend1
*.blend1.meta

# Unity Specific Large Files #
Mdfproject/[Mm]emoryCaptures/
Mdfproject/[Rr]ecordings/

# Gradle cache directory #
.gradle/

# Misc auto generated files #
ExportedObj/
.consulo/
*.tmp
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt
mono_crash.*

# Meta files for ignored files #
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build artifacts #
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file #
crashlytics-build.properties

# TestRunner generated files #
Mdfproject/InitTestScene*.unity*

# MDF harness generated artifacts #
artifacts/
_context_packer/output/
_context_bundles/

# Python cache files generated by harness tools/hooks #
__pycache__/
*.py[cod]

# Codex local agent/session state #
.codex/session-state/

# Addressables default ignores #
Mdfproject/ServerData/
Mdfproject/[Aa]ssets/StreamingAssets/aa*
Mdfproject/[Aa]ssets/AddressableAssetsData/link.xml*
Mdfproject/[Aa]ssets/Addressables_Temp*
Mdfproject/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files #
Mdfproject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
Mdfproject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
Mdfproject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
Mdfproject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# --- 3rd Party Assets (Team Decision) --- #
# Temporarily ignoring Photon package until team decision is made.


Mdfproject/Assets/StarterAssets
Mdfproject/Assets/StarterAssets.meta
nul
