.jl-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #061524;
    overflow: hidden;
}

.jl-design-space {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 941px;
    transform-origin: left top;
    -unity-font-definition: url("/Assets/Resources/Fonts & Materials/NotoSansKR-VariableFont_wght_UITK.asset");
    overflow: hidden;
}

.jl-background {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 941px;
    background-image: url("../../Resource/Image/UI/JoinLobby/bg_join_lobby_full.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.jl-left-menu-image-cover {
    position: absolute;
    left: 0;
    top: 0;
    width: 154px;
    height: 941px;
    background-color: #061524;
    border-right-width: 1px;
    border-right-color: rgba(18, 55, 82, 0.65);
}

.jl-top-hud,
.jl-room-panel {
    position: absolute;
}

.jl-top-hud {
    left: 0;
    top: 0;
    width: 1672px;
    height: 86px;
}

.jl-player-name {
    position: absolute;
    left: 151px;
    top: 24px;
    width: 180px;
    height: 30px;
    color: #fff1c8;
    font-size: 23px;
    -unity-font-style: bold;
    /* -unity-text-outline-width: 1px; */
    /* -unity-text-outline-color: #17100a; */
}

.jl-player-level {
    position: absolute;
    left: 151px;
    top: 57px;
    width: 86px;
    height: 28px;
    color: #fff3cb;
    font-size: 22px;
    -unity-font-style: bold;
    /* -unity-text-outline-width: 1px; */
    /* -unity-text-outline-color: #17100a; */
}

.jl-player-percent {
    position: absolute;
    left: 322px;
    top: 61px;
    width: 58px;
    height: 22px;
    color: #ffffff;
    font-size: 17px;
    -unity-font-style: bold;
    /* -unity-text-outline-width: 1px; */
    /* -unity-text-outline-color: #07101d; */
}

.jl-currency {
    position: absolute;
    top: 31px;
    height: 30px;
    color: #ffffff;
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    /* -unity-text-outline-width: 2px; */
    /* -unity-text-outline-color: #060b13; */
}

.jl-currency--gold {
    left: 767px;
    width: 84px;
}

.jl-currency--blue {
    left: 1013px;
    width: 96px;
}

.jl-currency--purple {
    left: 1226px;
    width: 78px;
}

.jl-alert-badge {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    color: #ffffff;
    background-color: #e84b3c;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.jl-alert-badge--bell {
    left: 1480px;
    top: 22px;
}

.jl-left-menu {
    display: none;
}

.jl-menu-label {
    display: none;
}

.jl-menu-label--lobby {
    top: 193px;
    color: #d8efff;
}

.jl-menu-label--quest {
    top: 276px;
}

.jl-menu-label--hero {
    top: 361px;
}

.jl-menu-label--bag {
    top: 444px;
}

.jl-menu-label--guild {
    top: 530px;
}

.jl-menu-label--shop {
    top: 612px;
}

.jl-menu-label--mail {
    top: 694px;
}

.jl-menu-label--settings {
    top: 776px;
}

.jl-alert-badge--settings {
    left: 123px;
    top: 756px;
}

.jl-clickable:hover {
    background-color: rgba(74, 160, 255, 0.10);
}

.jl-clickable:active {
    background-color: rgba(255, 255, 255, 0.10);
}

.jl-king-panel {
    position: absolute;
    left: 177px;
    top: 126px;
    width: 570px;
    height: 746px;
    background-color: rgba(5, 18, 31, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(71, 119, 154, 0.55);
    border-right-color: rgba(71, 119, 154, 0.55);
    border-top-color: rgba(121, 166, 198, 0.72);
    border-bottom-color: rgba(30, 61, 83, 0.82);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.jl-king-panel-title {
    position: absolute;
    left: 24px;
    top: 19px;
    width: 522px;
    height: 42px;
    color: #f3d39b;
    font-size: 29px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.jl-king-panel-subtitle {
    position: absolute;
    left: 24px;
    top: 59px;
    width: 522px;
    height: 28px;
    color: #a9bac8;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.jl-demon-panel-title {
    color: #ef9d9d;
}

.jl-demon-card-name {
    top: 10px;
    height: 25px;
    color: #ffb0a0;
    font-size: 18px;
}

.jl-demon-card-passive,
.jl-demon-card-skill {
    position: absolute;
    left: 136px;
    width: 106px;
    color: #d9e0e7;
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
}

.jl-demon-card-passive {
    top: 37px;
    height: 34px;
}

.jl-demon-card-skill {
    top: 72px;
    height: 39px;
