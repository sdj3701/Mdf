    height: 24px;
    font-size: 13px;
}

.jl-king-card {
    position: absolute;
    width: 252px;
    height: 142px;
    background-color: rgba(14, 38, 57, 0.9);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(87, 120, 143, 0.65);
    border-right-color: rgba(87, 120, 143, 0.65);
    border-top-color: rgba(114, 148, 171, 0.72);
    border-bottom-color: rgba(39, 70, 92, 0.85);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.jl-king-card--selected {
    background-color: rgba(24, 75, 116, 0.97);
    border-left-color: #ffc864;
    border-right-color: #ffc864;
    border-top-color: #ffe2a4;
    border-bottom-color: #b86d25;
}

.jl-king-card--0 { left: 22px; top: 98px; }
.jl-king-card--1 { left: 296px; top: 98px; }
.jl-king-card--2 { left: 22px; top: 253px; }
.jl-king-card--3 { left: 296px; top: 253px; }
.jl-king-card--4 { left: 22px; top: 408px; }
.jl-king-card--5 { left: 296px; top: 408px; }
.jl-king-card--6 { left: 159px; top: 563px; }

.jl-king-card-portrait {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 118px;
    height: 118px;
    background-color: rgba(3, 12, 20, 0.64);
