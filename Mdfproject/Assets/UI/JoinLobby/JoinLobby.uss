.jl-slot-ready {
    position: absolute;
    left: 33px;
    top: 330px;
    width: 112px;
    height: 28px;
    color: #b9e8ff;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
