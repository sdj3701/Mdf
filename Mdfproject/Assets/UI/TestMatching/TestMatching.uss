.tm-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #8fb5dc;
    overflow: hidden;
}

.tm-design-space {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 941px;
    transform-origin: left top;
    overflow: hidden;
}

.tm-background,
.tm-bg-sky,
.tm-bg-horizon,
.tm-bg-ground {
    position: absolute;
    left: 0;
    width: 1672px;
}

.tm-background {
    top: 0;
    height: 941px;
    background-color: #95b7dc;
}

.tm-bg-sky {
    top: 0;
    height: 505px;
    background-color: #9dbce1;
}

.tm-bg-horizon {
    top: 455px;
    height: 190px;
    background-color: #d4edf4;
}

.tm-bg-ground {
    top: 560px;
    height: 381px;
    background-color: #a8a5a3;
}

.tm-bg-cloud {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.28);
    border-radius: 80px;
}

.tm-bg-cloud--left {
    left: -90px;
    top: 480px;
    width: 640px;
    height: 120px;
}

.tm-bg-cloud--right {
    left: 945px;
    top: 470px;
    width: 760px;
    height: 118px;
}

.tm-header {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 128px;
}

.tm-title-label {
    position: absolute;
    left: 330px;
    top: 48px;
    width: 300px;
    height: 62px;
    color: #ffffff;
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tm-title-label--shadow {
    left: 326px;
    top: 52px;
    color: #38659b;
}

.tm-title-spark {
    position: absolute;
    top: 56px;
    width: 44px;
    height: 44px;
    color: #ffd15a;
    font-size: 39px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tm-title-spark--left {
    left: 274px;
}

.tm-title-spark--right {
    left: 578px;
}

.tm-clickable {
    picking-mode: position;
}

.tm-clickable:hover {
    opacity: 0.92;
}

.tm-clickable:active {
    opacity: 0.78;
}

.tm-small-button {
    position: absolute;
    background-color: #fbfaf7;
    border-radius: 16px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 4px;
    border-left-color: #d4d2cf;
    border-right-color: #d4d2cf;
    border-top-color: #f3f1ee;
    border-bottom-color: #c0bdb9;
}

.tm-refresh-button {
    left: 773px;
    top: 51px;
    width: 163px;
    height: 59px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.tm-button-icon {
    color: #787878;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tm-button-icon--refresh {
    width: 42px;
    height: 42px;
    font-size: 32px;
}

.tm-small-button-label {
    width: 92px;
    height: 42px;
    color: #666666;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.tm-room-list-panel {
    position: absolute;
    left: 107px;
    top: 127px;
    width: 858px;
    height: 733px;
    background-color: rgba(255, 255, 255, 0.58);
    border-radius: 21px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.86);
    border-right-color: rgba(255, 255, 255, 0.78);
    border-top-color: rgba(255, 255, 255, 0.86);
    border-bottom-color: rgba(255, 255, 255, 0.55);
}

.tm-room-list-scroll {
    position: absolute;
    left: 26px;
    top: 27px;
    width: 806px;
    height: 510px;
    background-color: rgba(255, 255, 255, 0);
}

.tm-room-list-scroll .unity-scroll-view__content-container {
    width: 806px;
}

.tm-room-list-content {
    width: 806px;
    flex-direction: column;
}

.tm-room-card {
    position: relative;
    width: 802px;
    height: 113px;
    margin-bottom: 11px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 14px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 4px;
    border-left-color: #e8e3dc;
    border-right-color: #e8e3dc;
    border-top-color: #ffffff;
    border-bottom-color: #d1ccc5;
    padding-left: 20px;
    padding-right: 16px;
}

.tm-room-card:hover {
    background-color: #ffffff;
}

.tm-room-card--waiting {
    border-left-color: #e9e3db;
    border-right-color: #e9e3db;
}

.tm-room-card--playing {
    border-left-color: #84bf70;
    border-right-color: #84bf70;
    border-top-color: #84bf70;
    border-bottom-color: #6ea75c;
}

.tm-room-card--full,
.tm-room-card--unavailable {
    opacity: 0.72;
}

.tm-room-rank-icon {
    width: 58px;
    height: 58px;
    margin-right: 20px;
    color: #c37b1f;
    font-size: 45px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tm-room-rank-icon--gold {
    color: #d88b20;
}

.tm-room-rank-icon--silver {
    color: #7e9cb8;
}

.tm-room-rank-icon--bronze {
    color: #a7662e;
}

.tm-room-info {
    width: 390px;
    height: 88px;
    justify-content: center;
}

.tm-room-name-label {
    width: 390px;
    height: 48px;
    color: #303030;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.tm-room-meta-row {
    width: 390px;
    height: 36px;
    flex-direction: row;
    align-items: center;
}

.tm-room-meta-icon {
    width: 30px;
    height: 30px;
    font-size: 21px;
    color: #626262;
    -unity-text-align: middle-center;
}

.tm-room-trophy-icon {
    color: #c88620;
}

.tm-room-meta-label {
    height: 32px;
    color: #585858;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.tm-player-count-label {
    width: 70px;
}

.tm-rule-label {
    width: 190px;
}

.tm-room-meta-divider {
    width: 2px;
    height: 28px;
    margin-left: 8px;
    margin-right: 15px;
    background-color: rgba(120, 120, 120, 0.32);
}

.tm-room-thumbnail {
    width: 107px;
    height: 77px;
    margin-left: 10px;
    margin-right: 22px;
    border-radius: 9px;
    overflow: hidden;
    background-color: #bfe6ff;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.8);
    border-right-color: rgba(150, 150, 150, 0.2);
    border-top-color: rgba(255, 255, 255, 0.8);
    border-bottom-color: rgba(100, 100, 100, 0.2);
}

.tm-thumb-sky,
.tm-thumb-ground,
.tm-thumb-tree,
.tm-thumb-house {
    position: absolute;
}

.tm-thumb-sky {
    left: 0;
    top: 0;
    width: 107px;
    height: 48px;
    background-color: #a8d8f5;
}

.tm-thumb-ground {
    left: 0;
    top: 43px;
    width: 107px;
    height: 34px;
    background-color: #77be64;
}

.tm-thumb-tree {
    width: 22px;
    height: 48px;
    background-color: #4ea75e;
    border-radius: 10px;
}

.tm-thumb-tree--left {
    left: 9px;
    top: 19px;
}

.tm-thumb-tree--right {
    left: 78px;
    top: 16px;
}

.tm-thumb-house {
    left: 39px;
    top: 28px;
    width: 34px;
    height: 30px;
    background-color: #d66a51;
    border-radius: 5px;
}

.tm-room-thumbnail--farm .tm-thumb-ground {
    background-color: #8ecc72;
}

.tm-room-thumbnail--farm .tm-thumb-house {
    background-color: #c44736;
}

.tm-room-thumbnail--candy .tm-thumb-sky {
    background-color: #e4caf8;
}

.tm-room-thumbnail--candy .tm-thumb-ground {
    background-color: #f3c88e;
}

.tm-room-thumbnail--candy .tm-thumb-house {
    background-color: #d98ad9;
}

.tm-room-thumbnail--beach .tm-thumb-sky {
    background-color: #95d9ff;
}

.tm-room-thumbnail--beach .tm-thumb-ground {
    background-color: #eed589;
}

.tm-room-thumbnail--beach .tm-thumb-tree {
    background-color: #55aa61;
}

.tm-room-status-wrap {
    width: 145px;
    height: 70px;
    flex-direction: row;
    align-items: center;
}

.tm-room-status-dot {
    width: 14px;
    height: 14px;
    margin-right: 12px;
    border-radius: 7px;
    background-color: #5caef4;
}

.tm-room-status-label {
    width: 115px;
    height: 42px;
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: #417ab5;
}

.tm-status--waiting .tm-room-status-dot {
    background-color: #59aef1;
}

.tm-status--waiting .tm-room-status-label {
    color: #417ab5;
}

.tm-status--playing .tm-room-status-dot {
    background-color: #61bd5a;
}

.tm-status--playing .tm-room-status-label {
    color: #58a94f;
}

.tm-status--full .tm-room-status-dot,
.tm-status--unavailable .tm-room-status-dot {
    background-color: #a7a7a7;
}

.tm-status--full .tm-room-status-label,
.tm-status--unavailable .tm-room-status-label {
    color: #777777;
}

.tm-empty-state {
