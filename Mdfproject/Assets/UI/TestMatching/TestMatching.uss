.tm-modal,
.tm-network-block-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 941px;
    background-color: rgba(0, 0, 0, 0.28);
    align-items: center;
    justify-content: center;
}

.tm-modal-panel {
    width: 430px;
    height: 230px;
    background-color: rgba(255, 255, 255, 0.96);
    border-radius: 18px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 5px;
    border-left-color: #e7e1dc;
    border-right-color: #e7e1dc;
