    height: 54px;
    margin-top: 30px;
    color: #3d3d3d;
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tm-modal-message {
    width: 360px;
    height: 54px;
    color: #696969;
    font-size: 19px;
    -unity-text-align: middle-center;
}

.tm-modal-close-button {
