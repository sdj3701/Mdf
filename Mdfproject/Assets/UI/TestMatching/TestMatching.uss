    color: #ffffff;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tm-network-block-label {
    width: 420px;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.92);
    color: #3d3d3d;
    border-radius: 16px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tm-hidden {
    display: none;
}
