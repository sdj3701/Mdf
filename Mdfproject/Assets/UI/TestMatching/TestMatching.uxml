<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/TestMatching/TestMatching.uss?fileID=7433441132597879392&amp;guid=2d17d8cbb7094f2a86ebac58f75533f4&amp;type=3#TestMatching" />
    <ui:VisualElement name="testmatching-root" class="tm-root">
        <ui:VisualElement name="testmatching-design-space" class="tm-design-space">
            <ui:VisualElement name="background" class="tm-background" />
            <ui:VisualElement name="topHud" class="tm-top-hud">
                <ui:Label text="모험가" class="tm-player-name" />
                <ui:Label text="LV. 28" class="tm-player-level" />
                <ui:Label text="65%" class="tm-player-percent" />
                <ui:Label text="125,900" class="tm-currency tm-currency--gold" />
                <ui:Label text="2,450" class="tm-currency tm-currency--blue" />
                <ui:Label text="310" class="tm-currency tm-currency--purple" />
                <ui:Label text="1" class="tm-alert-badge tm-alert-badge--bell" />
            </ui:VisualElement>
            <ui:VisualElement name="leftMenu" class="tm-left-menu">
                <ui:Label text="홈" class="tm-menu-label tm-menu-label--home" />
                <ui:Label text="영웅" class="tm-menu-label tm-menu-label--hero" />
                <ui:Label text="가방" class="tm-menu-label tm-menu-label--bag" />
                <ui:Label text="퀘스트" class="tm-menu-label tm-menu-label--quest" />
                <ui:Label text="길드" class="tm-menu-label tm-menu-label--guild" />
                <ui:Label text="상점" class="tm-menu-label tm-menu-label--shop" />
                <ui:Label text="설정" class="tm-menu-label tm-menu-label--settings" />
                <ui:Label text="1" class="tm-alert-badge tm-alert-badge--settings" />
            </ui:VisualElement>
            <ui:VisualElement name="lobbyPanel" class="tm-lobby-panel">
                <ui:Label text="로비" class="tm-lobby-title" />
                <ui:Label text="ROOM LOBBY" class="tm-lobby-subtitle" />
                <ui:VisualElement name="refreshButton" class="tm-clickable tm-refresh-button" />
                <ui:VisualElement name="createRoomButton" class="tm-clickable tm-create-room-button">
                    <ui:Label text="방 만들기" name="Label" class="tm-create-room-label" style="top: -4px; left: -4px;" />
                </ui:VisualElement>
                <ui:ScrollView name="roomListScroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="tm-room-list-scroll" style="height: 474px; top: 155px; width: 782px; left: 28px;">
                    <ui:VisualElement name="roomListContent" class="tm-room-list-content" />
                </ui:ScrollView>
                <ui:VisualElement name="emptyState" class="tm-empty-state" style="height: 467px; top: 161px; width: 778px; left: 30px;">
                    <ui:Label text="생성된 방이 없습니다." class="tm-empty-message" />
                </ui:VisualElement>
                <ui:Label text="방 이름 입력" class="tm-input-title" />
                <ui:VisualElement name="roomNameInputWrap" class="tm-room-name-input-wrap" style="width: 362px; left: 189px; height: 54px; top: 668px;">
                    <ui:TextField name="roomNameField" class="tm-room-name-field" />
                    <ui:Label name="roomNamePlaceholder" text="방 이름을 입력하세요" class="tm-room-name-placeholder" />
                    <ui:Label text="×" class="tm-input-clear-mark" />
                </ui:VisualElement>
                <ui:VisualElement name="directJoinButton" class="tm-clickable tm-direct-join-button" style="top: 661px; left: 588px;">
                    <ui:Label text="♛" class="tm-direct-join-icon" />
                    <ui:Label text="입장하기" class="tm-direct-join-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="backToTitleButton" class="tm-clickable tm-back-title-button" />
            <ui:Label name="statusLabel" class="tm-status-label tm-hidden" />
            <ui:VisualElement name="roomNotFoundModal" class="tm-modal tm-hidden">
                <ui:VisualElement class="tm-modal-panel">
                    <ui:Label text="방을 찾을 수 없습니다." class="tm-modal-title" />
                    <ui:Label name="roomNotFoundMessage" text="입력한 방 이름을 다시 확인해 주세요." class="tm-modal-message" />
                    <ui:VisualElement name="roomNotFoundCloseButton" class="tm-clickable tm-modal-close-button">
                        <ui:Label text="확인" class="tm-modal-close-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="networkBlockOverlay" class="tm-network-block-overlay tm-hidden">
                <ui:Label text="네트워크 처리 중입니다..." class="tm-network-block-label" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
