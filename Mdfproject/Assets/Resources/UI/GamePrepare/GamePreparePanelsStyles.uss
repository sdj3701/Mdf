/* GamePreparePanels 위치/크기 수정 가이드
   - 상점 카드 줄: .shop-panel의 padding-left/right/top
   - 상점 카드 크기: .shop-card의 width/height, 실제 런타임은 GamePrepareUIToolkitController.ApplyResponsiveSize가 덮어씀
   - 상점 카드 내부 초상화: .shop-icon의 width/height
   - 새로고침 버튼: .shop-control-row의 right/top, .toolkit-button의 width/height
   - 좌상단 옵션/상점/벽 버튼: .hud-icon-button, .game-hud-root, .hud-button
   - 라운드 타이머: .round-timer-label의 left/top/width/height
   - 골드/스톤 표시: .game-resource-root의 right/bottom, .resource-pill의 min-width/height
   - 공격 순서 패널: .attack-sequence-panel의 left/right/bottom, .attack-card의 width/height
   주의: C#에서 직접 style 값을 넣는 항목은 USS 미리보기와 실제 게임 위치가 다를 수 있습니다.
*/

.game-prepare-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-grow: 1;
    -unity-font-definition: url("/Assets/Resources/Fonts & Materials/NotoSansKR-VariableFont_wght_UITK.asset");
}

.game-prepare-safe-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.game-prepare-design-space {
    position: absolute;
    left: 0;
    top: 0;
    width: 1600px;
    height: 900px;
    transform-origin: left top;
    overflow: hidden;
    -unity-font-definition: url("/Assets/Resources/Fonts & Materials/NotoSansKR-VariableFont_wght_UITK.asset");
}

.game-left-wireframe-rail {
    display: none;
}

.wire-status-row {
    flex-direction: row;
}

.hidden {
    display: none;
}

.prepare-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(4, 7, 10, 0.42);
}

.augment-panel {
    /* EDIT 위치: padding-top을 키우면 증강 카드 줄이 아래로 내려갑니다. */
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 250px;
    padding-bottom: 56px;
}

.shop-panel {
    /* EDIT 위치: padding-top은 상점 카드 줄의 세로 위치, padding-left/right는 좌우 여백입니다. */
    padding-left: 120px;
    padding-right: 20px;
    padding-top: 132px;
    padding-bottom: 42px;
}

.screen-frame {
    position: absolute;
    background-color: rgba(222, 177, 77, 0.88);
}

.frame-top {
    left: 30px;
    right: 30px;
    top: 18px;
    height: 2px;
}

.frame-bottom {
    left: 30px;
    right: 30px;
    bottom: 18px;
    height: 2px;
}

.frame-left {
    left: 18px;
    top: 30px;
    bottom: 30px;
    width: 2px;
}

.frame-right {
    right: 18px;
    top: 30px;
    bottom: 30px;
    width: 2px;
}

.augment-card-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.shop-card-row {
    /* EDIT 정렬: center/flex-start로 상점 카드 줄의 기준 정렬을 조절합니다. */
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.choice-card {
    /* EDIT 간격: margin-left/right가 카드 사이 가로 간격입니다. */
    position: relative;
    margin-left: 14px;
    margin-right: 14px;
    background-color: rgb(8, 15, 24);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(204, 162, 74);
    border-right-color: rgb(204, 162, 74);
    border-top-color: rgb(232, 198, 103);
    border-bottom-color: rgb(161, 126, 58);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.choice-card:hover {
    border-left-color: rgb(255, 224, 130);
    border-right-color: rgb(255, 224, 130);
    border-top-color: rgb(255, 237, 156);
    border-bottom-color: rgb(218, 176, 82);
}

.choice-card:disabled {
    opacity: 0.54;
}

.augment-card {
    /* EDIT 크기: 증강 카드의 UI Builder 미리보기 크기입니다. */
    width: 332px;
    height: 480px;
}

.shop-card {
    /* EDIT 크기: 상점 카드의 UI Builder 미리보기 크기입니다. 실제 게임 크기는 C#에서 다시 계산됩니다. */
    width: 280px;
    height: 350px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgb(8, 15, 24);
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.shop-card-cost-1 {
    /* EDIT 이미지: 1코스트 카드 배경입니다. */
    background-image: url("../../../Resource/Image/UI/SlotUI/Spr_SlotGray.png");
}

.shop-card-cost-2 {
    /* EDIT 이미지: 2코스트 카드 배경입니다. */
    background-image: url("../../../Resource/Image/UI/SlotUI/Spr_SlotGreen.png");
}

.shop-card-cost-3 {
    /* EDIT 이미지: 3코스트 카드 배경입니다. */
    background-image: url("../../../Resource/Image/UI/SlotUI/Spr_SlotBlue.png");
}

.shop-card-cost-4 {
    /* EDIT 이미지: 4코스트 카드 배경입니다. */
    background-image: url("../../../Resource/Image/UI/SlotUI/Spr_SlotPurple.png");
}

.shop-card-cost-5 {
    /* EDIT 이미지: 5코스트 카드 배경입니다. */
    background-image: url("../../../Resource/Image/UI/SlotUI/Spr_SlotOrange.png");
}

.card-top-gem {
    /* EDIT 위치/크기: 카드 위 장식 위치는 top, 크기는 width/height입니다. */
    position: absolute;
    top: -24px;
    left: 50%;
    width: 42px;
    height: 42px;
    margin-left: -21px;
    background-color: rgb(218, 167, 52);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(93, 69, 33);
    border-right-color: rgb(93, 69, 33);
    border-top-color: rgb(255, 231, 129);
    border-bottom-color: rgb(123, 83, 29);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.card-body {
    /* EDIT 내부 위치: padding 값으로 카드 안의 아이콘/텍스트 위치를 조절합니다. */
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 26px;
    padding-bottom: 16px;
    background-color: rgb(7, 13, 21);
}

.card-icon {
    /* EDIT 공통 아이콘 크기: width/height가 기본 카드 아이콘 크기입니다. */
    width: 142px;
    height: 142px;
    margin-bottom: 12px;
    opacity: 0.92;
    -unity-background-scale-mode: scale-to-fit;
}

.augment-icon {
    /* EDIT 증강 아이콘 크기입니다. */
    width: 150px;
    height: 150px;
    opacity: 0.58;
    margin-bottom: 18px;
}

.shop-icon {
    /* EDIT 상점 초상화 크기입니다. */
    width: 140px;
    height: 140px;
}

.card-tier {
    /* EDIT 글자: 별/등급 텍스트 크기입니다. */
    color: rgb(215, 184, 100);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.card-name {
    /* EDIT 글자: 카드 이름 텍스트 크기와 아래 간격입니다. */
    color: rgb(242, 236, 220);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.card-description {
    /* EDIT 글자: 카드 설명/골드 텍스트 크기입니다. */
    color: rgb(184, 196, 217);
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.augment-card .card-body {
    justify-content: flex-start;
    padding-top: 34px;
}

.augment-card .card-name {
    font-size: 24px;
    margin-bottom: 10px;
}

.augment-card .card-description {
    font-size: 17px;
    white-space: normal;
}

.card-footer {
    /* EDIT 크기: 카드 아래 버튼/구매 영역 높이입니다. */
    height: 76px;
    align-items: center;
    justify-content: center;
    background-color: rgb(30, 43, 75);
    border-top-width: 2px;
    border-top-color: rgb(82, 92, 113);
}

.shop-card .card-top-gem {
    display: none;
}

.shop-card .card-body {
    background-color: rgba(0, 0, 0, 0);
}

.shop-card .card-footer {
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
}

.card-footer-label {
    /* EDIT 글자: 구매 버튼 글자 크기입니다. */
    color: rgb(245, 231, 194);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.sold-overlay {
    /* EDIT 크기/글자: 구매 완료 덮개는 카드 전체를 덮고, font-size로 글자 크기를 바꿉니다. */
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    color: rgb(241, 234, 215);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.68);
}

.shop-control-row {
    /* EDIT 위치: right/top이 새로고침 버튼 위치입니다. width/height는 버튼 영역 크기입니다. */
    position: absolute;
    right: 28px;
    top: 506px;
    width: 180px;
    height: 180px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.shop-status-label {
    /* EDIT 글자: 상점 상태 문구 크기와 버튼과의 간격입니다. */
    color: rgb(237, 218, 159);
    font-size: 18px;
    -unity-font-style: bold;
    margin-right: 16px;
}

.toolkit-button {
    /* EDIT 크기: 새로고침 버튼 크기입니다. radius는 width/height의 절반이면 둥글게 보입니다. */
    width: 180px;
    min-width: 180px;
    height: 180px;
    align-items: center;
    justify-content: center;
    background-color: rgba(9, 16, 26, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(203, 159, 68);
    border-right-color: rgb(203, 159, 68);
    border-top-color: rgb(237, 198, 88);
    border-bottom-color: rgb(151, 111, 46);
    border-top-left-radius: 90px;
    border-top-right-radius: 90px;
    border-bottom-left-radius: 90px;
    border-bottom-right-radius: 90px;
    padding-left: 26px;
    padding-right: 26px;
}

.toolkit-button:hover {
    background-color: rgba(36, 51, 81, 0.96);
}

.toolkit-button-label {
    /* EDIT 글자: 새로고침 버튼 글자 크기입니다. */
    color: rgb(248, 231, 181);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.game-hud-root {
    /* EDIT 위치: 우상단 상점/벽 버튼 묶음입니다. right/top과 width/height를 조절합니다. */
    position: absolute;
    right: 28px;
    top: 12px;
    width: 180px;
    height: 84px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.hud-button {
    /* EDIT 크기: 상점/벽 버튼 크기입니다. width/height/min-width를 같이 맞춥니다. */
    width: 84px;
    height: 84px;
    min-width: 84px;
    margin-left: 0;
    padding-left: 0;
    padding-right: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 14, 23, 0.92);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(184, 138, 50);
    border-right-color: rgb(184, 138, 50);
    border-top-color: rgb(246, 212, 103);
    border-bottom-color: rgb(117, 80, 30);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.hud-button:hover {
    background-color: rgba(33, 47, 74, 0.96);
    border-left-color: rgb(246, 212, 103);
    border-right-color: rgb(246, 212, 103);
}

.hud-icon-button {
    /* EDIT 위치: 옵션 버튼 위치입니다. left/top으로 이동합니다. */
    position: absolute;
    left: 28px;
    top: 12px;
    margin-left: 0;
    min-width: 84px;
}

.hud-action-button {
    min-width: 84px;
}

.hud-action-spaced {
    /* EDIT 간격: 상점 버튼과 벽 버튼 사이 간격입니다. */
    margin-left: 12px;
}

.hud-button-label {
    /* EDIT 글자: 좌상단 버튼 안 글자 크기입니다. */
    width: 84px;
    color: rgb(248, 232, 182);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud-button-active {
    background-color: rgba(42, 58, 92, 0.98);
    border-left-color: rgb(255, 232, 128);
    border-right-color: rgb(255, 232, 128);
    border-top-color: rgb(255, 241, 164);
    border-bottom-color: rgb(206, 153, 55);
}

.round-timer-label {
    /* EDIT 위치/크기: 라운드 타이머입니다. left/top으로 이동하고 width/height/font-size로 크기를 조절합니다. */
    position: absolute;
    left: 480px;
    top: 12px;
    width: 640px;
    height: 44px;
    color: rgb(248, 232, 182);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(8, 14, 23, 0.92);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(184, 138, 50);
    border-right-color: rgb(184, 138, 50);
    border-top-color: rgb(246, 212, 103);
    border-bottom-color: rgb(117, 80, 30);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.is-disabled {
    opacity: 0.46;
}

.game-resource-root {
    /* EDIT 위치: 골드/스톤 묶음입니다. right/bottom으로 위치를 조절합니다. */
    position: absolute;
    right: 28px;
    bottom: 26px;
    flex-direction: column;
    align-items: flex-end;
}

.resource-pill {
    /* EDIT 크기: 골드/스톤 한 줄 박스입니다. min-width/height와 padding을 같이 조절합니다. */
    min-width: 146px;
    height: 46px;
    margin-top: 8px;
    padding-left: 16px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(8, 14, 23, 0.92);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(184, 138, 50);
    border-right-color: rgb(184, 138, 50);
    border-top-color: rgb(246, 212, 103);
    border-bottom-color: rgb(117, 80, 30);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.resource-label {
    /* EDIT 글자: Gold/Stone 라벨 글자 크기입니다. */
    color: rgb(215, 184, 100);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 18px;
}

.resource-value {
    /* EDIT 글자: Gold/Stone 숫자 글자 크기입니다. */
    color: rgb(248, 232, 182);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.attack-sequence-panel {
    /* EDIT 위치: 공격 순서 선택 패널입니다. left/right/bottom으로 화면 안 위치를 조절합니다. */
    position: absolute;
    left: 24px;
    right: 184px;
    bottom: 22px;
    flex-direction: column;
    align-items: center;
}

.attack-monster-row,
.attack-scroll-row {
    /* EDIT 내부 여백: 공격 카드 줄의 padding과 배경 영역입니다. */
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(5, 10, 17, 0.78);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(179, 139, 61, 0.74);
    border-right-color: rgba(179, 139, 61, 0.74);
    border-top-color: rgba(231, 190, 86, 0.82);
    border-bottom-color: rgba(111, 76, 31, 0.82);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.attack-scroll-row {
    /* EDIT 간격: 몬스터 줄과 스크롤 줄 사이 세로 간격입니다. */
    margin-top: 8px;
}

.attack-card {
    /* EDIT 크기/간격: 공격 카드 크기는 width/height, 카드 사이 간격은 margin-left/right입니다. */
    position: relative;
    width: 82px;
    height: 96px;
    margin-left: 4px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
    background-color: rgb(8, 15, 24);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(130, 101, 51);
    border-right-color: rgb(130, 101, 51);
    border-top-color: rgb(199, 163, 78);
    border-bottom-color: rgb(92, 69, 34);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.attack-card:hover {
    border-left-color: rgb(246, 212, 103);
    border-right-color: rgb(246, 212, 103);
    border-top-color: rgb(255, 236, 146);
    border-bottom-color: rgb(194, 142, 49);
}

.attack-card-selected {
    background-color: rgb(27, 39, 63);
    border-left-color: rgb(255, 229, 118);
    border-right-color: rgb(255, 229, 118);
    border-top-color: rgb(255, 245, 164);
    border-bottom-color: rgb(215, 158, 55);
}

.attack-card-icon {
    /* EDIT 크기: 공격 카드 아이콘 크기입니다. */
    width: 42px;
    height: 42px;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.attack-card-name {
    /* EDIT 글자: 공격 카드 이름 글자 크기입니다. */
    width: 100%;
    color: rgb(242, 236, 220);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
}

.attack-card-count {
    /* EDIT 글자: 공격 카드 수량 글자 크기입니다. */
    color: rgb(237, 218, 159);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.scroll-attack-card {
    /* EDIT 크기: 스크롤 공격 카드 높이입니다. */
    height: 84px;
    background-color: rgb(20, 15, 35);
}

.scroll-attack-icon {
    /* EDIT 크기: 스크롤 공격 카드 아이콘 크기입니다. */
    width: 38px;
    height: 38px;
}

.scroll-attack-name {
    /* EDIT 글자: 스크롤 공격 카드 이름 글자 크기입니다. */
    color: rgb(225, 211, 248);
    font-size: 12px;
}
