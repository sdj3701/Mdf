.game-prepare-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Resources/Fonts%20&%20Materials/NotoSansKR-VariableFont_wght_UITK.asset?fileID=11400000&guid=9c2a7d7936fa41642b7f7f1396b8f8bc&type=2#NotoSansKR-VariableFont_wght_UITK");
}

.game-prepare-safe-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.game-prepare-design-space {
    position: absolute;
    left: 0;
    top: 0;
    width: 1600px;
    height: 900px;
    transform-origin: left top;
    overflow: hidden;
    -unity-font-definition: url("project://database/Assets/Resources/Fonts%20&%20Materials/NotoSansKR-VariableFont_wght_UITK.asset?fileID=11400000&guid=9c2a7d7936fa41642b7f7f1396b8f8bc&type=2#NotoSansKR-VariableFont_wght_UITK");
}

.game-left-wireframe-rail {
    display: none;
}

.wire-status-row {
    flex-direction: row;
}

.hidden {
    display: none;
}

.prepare-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(4, 7, 10, 0.42);
}

.augment-panel {
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 250px;
    padding-bottom: 56px;
}

.shop-panel {
    padding-left: 120px;
    padding-right: 20px;
    padding-top: 132px;
    padding-bottom: 42px;
}

.screen-frame {
    position: absolute;
    background-color: rgba(222, 177, 77, 0.88);
}

.frame-top {
    left: 30px;
    right: 30px;
    top: 18px;
    height: 2px;
}

.frame-bottom {
    left: 30px;
    right: 30px;
    bottom: 18px;
    height: 2px;
}

.frame-left {
    left: 18px;
    top: 30px;
    bottom: 30px;
    width: 2px;
}

.frame-right {
    right: 18px;
    top: 30px;
    bottom: 30px;
    width: 2px;
}

.augment-card-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.shop-card-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.choice-card {
    position: relative;
    margin-left: 14px;
    margin-right: 14px;
    background-color: rgb(8, 15, 24);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(204, 162, 74);
    border-right-color: rgb(204, 162, 74);
    border-top-color: rgb(232, 198, 103);
    border-bottom-color: rgb(161, 126, 58);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.choice-card:hover {
    border-left-color: rgb(255, 224, 130);
    border-right-color: rgb(255, 224, 130);
    border-top-color: rgb(255, 237, 156);
    border-bottom-color: rgb(218, 176, 82);
}

.choice-card:disabled {
    opacity: 0.54;
}

.augment-card {
    width: 332px;
    height: 480px;
}

.shop-card {
    width: 280px;
    height: 350px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgb(8, 15, 24);
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.shop-card-star-1 {
    background-image: url("project://database/Assets/Resource/Image/UI/SlotUI/Spr_SlotGray.png?fileID=21300000&guid=e92700a15c3cbf14caa7a22b0252ba33&type=3#Spr_SlotGray");
}

.shop-card-star-2 {
    background-image: url("project://database/Assets/Resource/Image/UI/SlotUI/Spr_SlotGreen.png?fileID=21300000&guid=3791f64c32ca2c44c9e158cefb12a9b1&type=3#Spr_SlotGreen");
}

.shop-card-star-3 {
    background-image: url("project://database/Assets/Resource/Image/UI/SlotUI/Spr_SlotBlue.png?fileID=21300000&guid=93b97824a226aa642962af23863abb6b&type=3#Spr_SlotBlue");
