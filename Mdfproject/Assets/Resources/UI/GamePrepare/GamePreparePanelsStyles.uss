.card-top-gem {
    position: absolute;
    top: -24px;
    left: 50%;
    width: 42px;
    height: 42px;
    margin-left: -21px;
    background-color: rgb(218, 167, 52);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(93, 69, 33);
    border-right-color: rgb(93, 69, 33);
    border-top-color: rgb(255, 231, 129);
    border-bottom-color: rgb(123, 83, 29);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.card-body {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 26px;
    padding-bottom: 16px;
    background-color: rgb(7, 13, 21);
}

.card-icon {
    width: 142px;
    height: 142px;
    margin-bottom: 12px;
    opacity: 0.92;
    -unity-background-scale-mode: scale-to-fit;
}

.augment-icon {
    width: 150px;
    height: 150px;
    opacity: 0.58;
    margin-bottom: 18px;
}

.shop-icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin-bottom: 0;
    opacity: 1;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.card-tier {
    color: rgb(215, 184, 100);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.card-name {
    color: rgb(242, 236, 220);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.card-description {
    color: rgb(184, 196, 217);
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.augment-card .card-body {
    justify-content: flex-start;
    padding-top: 34px;
}

.augment-card .card-name {
    font-size: 24px;
    margin-bottom: 10px;
}

.augment-card .card-description {
    font-size: 17px;
    white-space: normal;
}

.card-footer {
