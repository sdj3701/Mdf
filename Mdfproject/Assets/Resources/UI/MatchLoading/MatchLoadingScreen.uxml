<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="match-loading-root" class="ml-root">
        <ui:VisualElement class="ml-backdrop" />
        <ui:VisualElement class="ml-vignette" />
        <ui:VisualElement class="ml-content">
            <ui:Label text="MDF  •  BATTLEFIELD" class="ml-eyebrow" />
            <ui:Label name="match-loading-stage" text="전장 자원을 확인하는 중" class="ml-stage" />
            <ui:VisualElement name="match-loading-art" class="ml-art-frame">
                <ui:VisualElement class="ml-art" />
                <ui:VisualElement class="ml-art-shade" />
                <ui:Label text="전투가 곧 시작됩니다" class="ml-art-caption" />
            </ui:VisualElement>
            <ui:VisualElement class="ml-tip-row">
                <ui:Label text="GAME TIP" class="ml-tip-badge" />
                <ui:Label name="match-loading-tip" text="준비 단계에서 유닛 배치와 미로를 미리 완성해 두세요." class="ml-tip" />
            </ui:VisualElement>
            <ui:VisualElement class="ml-progress-area">
                <ui:VisualElement name="match-loading-track" class="ml-track">
                    <ui:VisualElement name="match-loading-fill" class="ml-fill" />
                    <ui:VisualElement name="match-loading-runner" class="ml-runner">
                        <ui:VisualElement class="ml-runner-speed-line ml-runner-speed-line--top" />
                        <ui:VisualElement class="ml-runner-speed-line ml-runner-speed-line--bottom" />
                        <ui:VisualElement class="ml-runner-shadow" />
                        <ui:VisualElement class="ml-runner-image" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="ml-progress-copy">
                    <ui:Label name="match-loading-peers" text="동료 연결 확인 중" class="ml-peers" />
                    <ui:Label name="match-loading-percent" text="00%" class="ml-percent" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
